{
  "name": "content-translation",
  "version": "1.7.0",
  "title": "Content Translation",
  "description": "Reviewed translations for posts, pages, database theme partials, file-backed theme fields, categories, locale-prefixed URLs, and hreflang metadata.",
  "author": "Adam Muiz",
  "author_uri": "https://jyavani.com/member/adammuiz/",
  "plugin_uri": "https://jyavani.com/plugin/content-translation/",
  "homepage": "https://jyavani.com/plugin/content-translation/",
  "github_url": "https://github.com/adammuizweb/content-translation",
  "store": {
    "url": "https://jyavani.com/plugin-store",
    "slug": "content-translation"
  },
  "icon": "icon.png",
  "requires": {
    "jyavani": ">=2.3.49",
    "php": ">=8.1",
    "extensions": ["pdo", "json"]
  },
  "admin": {
    "pages": [
      {
        "route": "admin/tools/content-translation",
        "file": "admin/index.php",
        "title": "Content Translation",
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/edit",
        "file": "admin/edit.php",
        "title": "Edit Translation",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/posts",
        "file": "admin/index.php",
        "title": "Translate Posts",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/pages",
        "file": "admin/index.php",
        "title": "Translate Pages",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/themes",
        "file": "admin/index.php",
        "title": "Translate Theme Partials",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/theme-files",
        "file": "admin/index.php",
        "title": "Translate Theme Files",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/theme-file-edit",
        "file": "admin/theme-file-edit.php",
        "title": "Edit Theme File Translation",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/category-edit",
        "file": "admin/category-edit.php",
        "title": "Edit Category Translation",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/settings",
        "file": "admin/settings.php",
        "title": "Translation Settings",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/export",
        "file": "admin/export.php",
        "title": "Export Translation Backup",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/api/save",
        "file": "admin/api/save.php",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/api/delete",
        "file": "admin/api/delete.php",
        "hidden": true,
        "roles": ["admin"]
      }
    ],
    "nav": [
      {
        "label": "Content Translation",
        "icon": "globe",
        "page": "admin/tools/content-translation",
        "parent": "tools",
        "roles": ["admin"]
      }
    ]
  },
  "static": {
    "copy": [
      {
        "from": "assets/css/translate.css",
        "to": "static/plugins/content-translation/content-translation.css"
      }
    ]
  },
  "assets": {
    "css": ["/static/plugins/content-translation/content-translation.css?v=1.7.0"],
    "js": []
  }
}
