{
  "name": "content-translation",
  "version": "1.1.0",
  "title": "Content Translation",
  "description": "Manual content translation for posts and pages — per-locale title, slug, and content with locale-prefixed URLs (/id/, /de/), language switcher widget, and hreflang tags.",
  "author": "Adam Muiz",
  "author_uri": "https://jyavani.com/member/adammuiz/",
  "plugin_uri": "https://jyavani.com/plugin/content-translation/",
  "homepage": "https://jyavani.com/plugin/content-translation/",
  "icon": "icon.png",
  "requires": {
    "php": ">=8.1",
    "extensions": ["pdo", "json"]
  },
  "admin": {
    "pages": [
      {
        "route": "admin/tools/content-translation",
        "file": "admin/index.php",
        "title": "Content Translation",
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/edit",
        "file": "admin/edit.php",
        "title": "Edit Translation",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/settings",
        "file": "admin/settings.php",
        "title": "Translation Settings",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/api/save",
        "file": "admin/api/save.php",
        "hidden": true,
        "roles": ["admin"]
      },
      {
        "route": "admin/tools/content-translation/api/delete",
        "file": "admin/api/delete.php",
        "hidden": true,
        "roles": ["admin"]
      }
    ],
    "nav": [
      {
        "label": "Content Translation",
        "icon": "globe",
        "page": "admin/tools/content-translation",
        "parent": "tools",
        "roles": ["admin"]
      }
    ]
  },
  "static": {
    "copy": [
      {
        "from": "assets/css/translate.css",
        "to": "static/css/content-translation.css"
      }
    ]
  },
  "assets": {
    "css": ["/static/css/content-translation.css"],
    "js": []
  }
}
